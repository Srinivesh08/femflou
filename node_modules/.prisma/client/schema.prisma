generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  RESEARCHER
  ADMIN
}

enum SampleStatus {
  UPLOADED
  PROCESSING
  ANALYZED
  FAILED
}

enum BiomarkerType {
  ALBUMIN
  GLUCOSE
  KETONES
  LEUKOCYTE_ESTERASE
  NITRITE
  PH
}

enum RiskStatus {
  NORMAL
  MILD
  HIGH
  CRITICAL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile   PatientProfile?  @relation("UserPatientProfile")
  assignedPatients PatientProfile[] @relation("DoctorPatients")
  reviewedReports  Report[]
  doctorComments   DoctorComment[]
}

model PatientProfile {
  id                            String    @id @default(uuid())
  userId                        String    @unique
  user                          User      @relation("UserPatientProfile", fields: [userId], references: [id])
  dateOfBirth                   DateTime?
  gestationalWeekAtRegistration Int?
  currentGestationalWeek        Int?
  assignedDoctorId              String?
  assignedDoctor                User?     @relation("DoctorPatients", fields: [assignedDoctorId], references: [id])
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  samples Sample[]
}

model Sample {
  id              String         @id @default(uuid())
  patientId       String
  patient         PatientProfile @relation(fields: [patientId], references: [id])
  imageUrl        String
  uploadedAt      DateTime       @default(now())
  brightnessScore Float?
  focusScore      Float?
  status          SampleStatus

  biomarkerResults BiomarkerResult[]
  report           Report?
}

model BiomarkerResult {
  id              String        @id @default(uuid())
  sampleId        String
  sample          Sample        @relation(fields: [sampleId], references: [id])
  biomarkerType   BiomarkerType
  measuredValue   Float
  unit            String
  riskStatus      RiskStatus
  confidenceScore Float
  interpretation  String?
}

model Report {
  id                 String    @id @default(uuid())
  sampleId           String    @unique
  sample             Sample    @relation(fields: [sampleId], references: [id])
  overallRiskScore   Float
  aiSummary          String?
  recommendations    String?
  reviewedByDoctorId String?
  reviewedByDoctor   User?     @relation(fields: [reviewedByDoctorId], references: [id])
  reviewedAt         DateTime?
  isAlert            Boolean   @default(false)
  alertMessage       String?
  createdAt          DateTime  @default(now())

  doctorComments DoctorComment[]
}

model DoctorComment {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id])
  comment   String
  createdAt DateTime @default(now())
}

model CalibrationCurve {
  id                  String        @id @default(uuid())
  biomarkerType       BiomarkerType
  dataPoints          Json
  regressionSlope     Float
  regressionIntercept Float
  rSquared            Float
  updatedAt           DateTime      @updatedAt
}
